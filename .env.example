
# ----------------- База данных (MSSQL) -----------------
DB_SERVER=localhost
DB_NAME=MindMirrorDB
DB_USER=sa
DB_PASSWORD=your_db_password

# ----------------- Порты серверов -----------------
# Основной сервер (server.js) — регистрация, логин, тесты, подписки, отзывы
PORT=3000
# Сервер анализа отзывов ИИ (analyze-server.js)
ANALYZE_PORT=3001
# Сервер статистики посещений (stats-server.js)
STATS_PORT=3002

# ----------------- Gemini API (ИИ-чат и анализ отзывов) -----------------
# Получить ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ----------------- Resend (отправка email) -----------------
# Получить ключ: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
SUPPORT_EMAIL=support@yourdomain.com
